rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow anyone to read files (e.g., public profile pictures, highlight videos)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to write to their own 'avatars' folder.
    // Ensure the uploaded file is an image and not too large.
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Allow authenticated users to write to their own 'covers' folder.
    // Allow images and short videos.
    match /covers/{userId}/{fileName} {
       allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024 // Max 20MB
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // Allow authenticated users to write to their own 'highlights' folder.
    // Ensure the uploaded file is a video and not excessively large.
    match /highlights/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024 // Max 50MB
                   && request.resource.contentType.matches('video/.*');
    }
  }
}
