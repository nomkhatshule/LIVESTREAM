rules_version = '2';

// LiveNet Storage security rules.
// Files are public to read (profile pictures, covers, highlights, chat images),
// but you can only upload into folders named with your own user id.
service firebase.storage {
  match /b/{bucket}/o {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function under(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isUser(userId) && under(5) && isImage();
      allow delete: if isUser(userId);
    }

    match /covers/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isUser(userId) && under(20) && (isImage() || isVideo());
      allow delete: if isUser(userId);
    }

    match /highlights/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isUser(userId) && under(50) && isVideo();
      allow delete: if isUser(userId);
    }

    // Chat images: chat_images/{broadcastId}/{uploaderUid}/{file}
    match /chat_images/{broadcastId}/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isUser(userId) && under(2) && isImage();
      allow delete: if isUser(userId);
    }

    // Images uploaded before this change (no uploader folder) stay readable.
    match /chat_images/{broadcastId}/{fileName} {
      allow read: if true;
    }
  }
}
