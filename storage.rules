rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the avatars directory
    match /avatars/{userId}/{allPaths=**} {
      // Anyone can read avatars (e.g., for viewing profiles)
      allow read;
      // Only the authenticated user can write to their own avatar directory
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
