rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for all files, as avatars are public.
    match /{allPaths=**} {
      allow read;
    }

    // Allow an authenticated user to write (upload, update, delete) to their own
    // personal avatar directory, identified by their UID.
    match /avatars/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
