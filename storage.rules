rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for user avatars
    // Path: /avatars/{userId}/profile.png
    match /avatars/{userId}/profile.png {
      // Allow anyone to read avatars.
      allow read: if true;
      
      // Allow a user to write (create, update, delete) to their own avatar path ONLY.
      // - The user must be authenticated (request.auth != null).
      // - The user's UID must match the {userId} in the path.
      // - The uploaded file size must be less than 5MB.
      // - The uploaded file must be an image.
      allow write: if request.auth != null && 
                    request.auth.uid == userId &&
                    request.resource.size < 5 * 1024 * 1024 &&
                    request.resource.contentType.matches('image/.*');
    }
    
    // Deny all other read/write operations on all other files by default.
  }
}
