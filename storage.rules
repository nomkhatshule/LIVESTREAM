rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for user avatars
    match /avatars/{userId}/{fileName} {

      // Anyone can read a user's avatar. This is necessary for profile pages.
      allow read;

      // Only the authenticated user can upload their own avatar.
      // We also add checks for file size and type for better security.
      allow write: if request.auth != null && 
                    request.auth.uid == userId &&
                    request.resource.size < 5 * 1024 * 1024 && // Max 5MB
                    request.resource.contentType.matches('image/.*'); // Must be an image
    }
  }
}