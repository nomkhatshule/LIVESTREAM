rules_version = '2';

service firebase.storage {
  match /b/studio-5881083204-f3849.appspot.com/o {
    match /avatars/{userId}/{allPaths=**} {
      // Temporarily allow any authenticated user to read and write
      // to help debug the permission issue.
      allow read, write: if request.auth != null;
    }
  }
}
