rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Grant read access to all files to any user.
    // This allows public read access for assets like avatars.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Grant write access only to a user's own avatar path.
    // - The user must be authenticated (request.auth != null).
    // - The user's UID must match the {userId} wildcard in the path.
    // - This prevents users from writing to other users' avatar paths.
    match /avatars/{userId}/profile.png {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
