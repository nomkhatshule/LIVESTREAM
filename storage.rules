rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the 'avatars' directory
    match /avatars/{userId}/{fileName} {
      // Allow read access to anyone (for displaying profile pictures)
      allow read;
      // Allow write access (create, update, delete) only if the user is authenticated
      // and the `userId` in the path matches their own UID.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
