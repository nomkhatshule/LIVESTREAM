rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for user avatars
    match /avatars/{userId}/{allPaths=**} {
      // Anyone can read (view) any avatar. This is necessary for profile pictures to be public.
      allow read;
      
      // Only the authenticated user can write (upload/update/delete) to their own avatar path.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
