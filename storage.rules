rules_version = '2';

// The next line must be updated to match your Firebase project's storage bucket URL.
service firebase.storage {
  match /b/studio-5881083204-f3849.appspot.com/o {
    
    // User Avatars:
    // Allow users to upload files to a folder matching their user ID.
    // Allow anyone to read these files (as they are public profile pictures).
    match /user-avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
