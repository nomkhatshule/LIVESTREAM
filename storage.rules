rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for user avatars
    match /avatars/{userId}/{allPaths=**} {
      // Allow anyone to read (view) any avatar.
      // This is necessary for other users to see profile pictures.
      allow read;
      
      // Only allow the authenticated user to write (upload, update, delete)
      // their own avatar. This prevents users from changing other people's pictures.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
