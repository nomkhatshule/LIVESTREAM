rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match the path for user avatars. The {userId} wildcard captures the user's ID.
    // This rule applies to files like "avatars/user123/profile.png"
    match /avatars/{userId}/{allPaths=**} {
      // Allow public read access to all avatars so they can be displayed in the app.
      allow read: if true;

      // Allow write (create, update, delete) only if the requesting user
      // is authenticated AND their UID matches the {userId} in the file path.
      // This ensures users can only change their own avatar.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
