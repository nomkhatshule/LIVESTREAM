rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // This ruleset is for debugging avatar uploads.
    // It allows any authenticated user to write files to the avatars path.
    // It also allows anyone, even unauthenticated users, to read files.
    match /avatars/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
