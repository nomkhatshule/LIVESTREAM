rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the 'avatars' directory
    match /avatars/{userId}/{fileName} {
      // Allow public read access to all avatars
      allow read: if true;

      // Allow write (create, update, delete) only if the user is authenticated
      // and their UID matches the {userId} in the path.
      // This ensures users can only manage their own avatars.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
