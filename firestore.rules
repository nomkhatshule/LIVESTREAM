rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read, write, update, and delete their own profile data.
    // This allows them to manage their username, bio, and profile picture URL.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Broadcasts are publicly readable by anyone.
    // Only an authenticated user can create a broadcast.
    // Only the original host of the broadcast can update or delete it.
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostId == request.auth.uid;

      // Chat messages within a broadcast can be read by anyone.
      // Only authenticated users can post new chat messages.
      match /chatMessages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
        // Generally, you don't allow users to update or delete chat messages.
        allow update, delete: if false;
      }
    }
  }
}
