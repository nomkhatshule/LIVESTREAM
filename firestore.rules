/**
 * @file Firestore Security Rules for AgoraLive
 * @description This ruleset enforces a user-ownership model for user profiles
 * and manages access to live broadcast data and interactions.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information, secured by owner-only access.
 * - /broadcasts/{broadcastId}: Stores metadata about live stream sessions, with public read access.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Stores chat messages for a specific broadcast; access is not restricted in this prototype.
 * - /broadcasts/{broadcastId}/reactions/{reactionId}: Stores real-time reactions; access is not restricted in this prototype.
 * - /broadcasts/{broadcastId}/guests/{guestId}: Manages broadcast guests; access is not restricted in this prototype.
 * - /broadcasts/{broadcastId}/likes/{likeId}: Stores likes for a broadcast; users can only like once, and the rule validates that the ID is their own UID.
 * - /users/{userId}/following/{targetUserId}: Stores follow relationships, secured by owner-only access.
 * - /users/{userId}/followers/{followerUserId}: Stores follower relationships, secured by owner-only access.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Broadcast data is publicly readable.
 * - The rules do not enforce a particular schema during the prototyping phase.
 * - List operation for broadcasts is public.
 * - Likes are restricted to one per user per broadcast.
 *
 * Denormalization for Authorization:
 * - The 'Broadcast' document denormalizes 'hostName' and 'hostAvatar' to optimize reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by the authenticated user.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} - True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} - True if a user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} - True if the user IDs match and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines access rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - An authenticated user can create their profile if the userId matches their auth UID.
     * @allow (get, update, delete) - An authenticated user can only access their own profile.
     * @deny (create) - A user cannot create a profile with an ID that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot modify or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for broadcasts. Broadcasts are publicly readable, but writes are not secured.
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) - Anyone can read broadcast data.
     * @deny (create, update, delete) - Writes are not secured.
     * @principle Public read access with owner-only writes.
     */
    match /broadcasts/{broadcastId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.

          /**
           * @description Defines access rules for likes subcollection
           * @path /broadcasts/{broadcastId}/likes/{likeId}
           * @allow (list) - Anyone who is signed in can list the likes
           * @allow (get) - Anyone who is signed in can get a specific like document.
           * @allow (create) - A user can create their own like document
           * @allow (delete) - A user can delete their own like document
           * @deny (update) - No one can update the like document.
           * @principle Restricts access to a user's own data tree.
           */
          match /likes/{likeId} {
            allow list: if isSignedIn();
            allow get: if isSignedIn();
            allow create: if isSignedIn() && request.auth.uid == likeId;
            allow delete: if isSignedIn() && request.auth.uid == likeId;
            allow update: if false;
          }

          /**
           * @description Defines access rules for chat messages. Access is open for prototyping.
           * @path /broadcasts/{broadcastId}/messages/{messageId}
           * @allow (get, list, create, update, delete) - Access is open for all authenticated users.
           * @principle Open access for prototyping.
           */
          match /messages/{messageId} {
            allow get: if true;
            allow list: if true;
            allow create: if true;
            allow update: if false;
            allow delete: if false;
          }

          /**
           * @description Defines access rules for reactions. Access is open for prototyping.
           * @path /broadcasts/{broadcastId}/reactions/{reactionId}
           * @allow (get, list, create, update, delete) - Access is open for all authenticated users.
           * @principle Open access for prototyping.
           */
          match /reactions/{reactionId} {
            allow get: if true;
            allow list: if true;
            allow create: if true;
            allow update: if false;
            allow delete: if false;
          }

          /**
           * @description Defines access rules for guests. Access is open for prototyping.
           * @path /broadcasts/{broadcastId}/guests/{guestId}
           * @allow (get, list, create, update, delete) - Access is open for all authenticated users.
           * @principle Open access for prototyping.
           */
          match /guests/{guestId} {
            allow get: if true;
            allow list: if true;
            allow create: if true;
            allow update: if false;
            allow delete: if false;
          }
    }

    /**
     * @description Defines access rules for following relationships.
     * @path /users/{userId}/following/{targetUserId}
     * @allow (create) - An authenticated user can create a follow relationship if the userId matches their auth UID.
     * @allow (get, update, delete) - An authenticated user can only access their own follow relationships.
     * @deny (create) - A user cannot create a follow relationship with an ID that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot modify or delete another user's follow relationships.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/following/{targetUserId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for follower relationships.
     * @path /users/{userId}/followers/{followerUserId}
     * @allow (create) - An authenticated user can create a follower relationship if the userId matches their auth UID.
     * @allow (get, update, delete) - An authenticated user can only access their own follower relationships.
     * @deny (create) - A user cannot create a follower relationship with an ID that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot modify or delete another user's follower relationships.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/followers/{followerUserId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if isExistingOwner(userId);
    }
  }
}