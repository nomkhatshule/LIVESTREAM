/**
 * @fileoverview Firestore Security Rules for AgoraLive.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access to broadcasts while restricting write access to owners.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data; userId must match the authenticated user's UID.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Stores chat messages for broadcasts.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Public read access is granted for broadcasts.
 * - Only owners can modify broadcasts.
 *
 * Denormalization for Authorization:
 *  None
 *
 * Structural Segregation:
 *  User profiles are stored in a dedicated /users/{userId} collection, ensuring private access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create, update, get, delete, list) if the request is made by the user with matching userId
     * @deny (create, update, get, delete, list) if the request is made by a different user or unauthenticated user
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read chat messages. Only allow broadcast owner to create messages.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (get, list) any user, authenticated or not
     * @allow (create) the authenticated user
     * @deny (create) if the user is not authenticated.
     * @deny (update, delete) all users.
     * @principle Open read access with owner-only writes
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Allows anyone to read broadcasts. Only allow owner to update broadcasts to stop live
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) any user, authenticated or not
     * @allow (update) the authenticated user with specific clause isLive
     * @deny (create) if the user is not authenticated.
     * @deny (update, delete) all users.
     * @principle Open read access with owner-only writes
     */
    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}