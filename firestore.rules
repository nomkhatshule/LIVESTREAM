/**
 * @fileoverview Firestore Security Rules for AgoraLive platform.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and a public-read, owner-write model for broadcasts.
 * Subcollections inherit the security context of their parent documents.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. The userId must match the Firebase Auth UID.
 * - /broadcasts/{broadcastId}: Stores metadata about live stream sessions. Accessible for public read, but write-protected to the host.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Chat messages for a specific broadcast. Accessible for authenticated users.
 * - /broadcasts/{broadcastId}/reactions/{reactionId}: Real-time reactions for a specific broadcast. Accessible for authenticated users.
 * - /broadcasts/{broadcastId}/guests/{guestId}: Manages guest states for a broadcast.
 * - /broadcasts/{broadcastId}/likes/{userId}: Tracks likes for a broadcast.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Broadcasts are publicly readable to enable discoverability.
 * - Only the host can modify or delete a broadcast.
 * - All authenticated users can post chat messages and reactions.
 * - Listing all users is disallowed.
 *
 * Denormalization for Authorization:
 * - The `Broadcast` document denormalizes `hostId`, `hostName`, and `hostAvatar` to avoid extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile if authenticated as 'user123'.
     * @allow (get) User with ID 'user123' can read their profile if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update their profile if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete their profile if authenticated as 'user123'.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123' when authenticated as 'user456'.
     * @deny (update) User with ID 'user456' cannot update the profile of 'user123' when authenticated as 'user456'.
     * @deny (delete) User with ID 'user456' cannot delete the profile of 'user123' when authenticated as 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to broadcasts, but restricts writes to the host.
     * @path /broadcasts/{broadcastId}
     * @allow (get) Any user can read a broadcast.
     * @allow (list) Any user can list broadcasts.
     * @allow (create) User with ID 'user123' can create a broadcast with hostId 'user123'.
     * @allow (update) User with ID 'user123' can update a broadcast if they are the host.
     * @allow (delete) User with ID 'user123' can delete a broadcast if they are the host.
     * @deny (create) User with ID 'user456' cannot create a broadcast with hostId 'user123'.
     * @deny (update) User with ID 'user456' cannot update a broadcast if they are not the host.
     * @deny (delete) User with ID 'user456' cannot delete a broadcast if they are not the host.
     * @principle Public read with owner-only writes.
     */
    match /broadcasts/{broadcastId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.hostId);
      allow delete: if isExistingOwner(resource.data.hostId);
    }

    /**
     * @description Allows authenticated users to post chat messages to a broadcast.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (create) Any authenticated user can create a chat message.
     * @allow (get) Any authenticated user can read a chat message.
     * @allow (list) Any authenticated user can list chat messages.
     * @deny (update) No one can update a chat message.
     * @deny (delete) No one can delete a chat message.
     * @principle Authenticated users can create content; no updates or deletes allowed.
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows authenticated users to send reactions to a broadcast.
     * @path /broadcasts/{broadcastId}/reactions/{reactionId}
     * @allow (create) Any authenticated user can create a reaction.
     * @allow (get) Any authenticated user can read a reaction.
     * @allow (list) Any authenticated user can list reactions.
     * @deny (update) No one can update a reaction.
     * @deny (delete) No one can delete a reaction.
     * @principle Authenticated users can create content; no updates or deletes allowed.
     */
    match /broadcasts/{broadcastId}/reactions/{reactionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages guest states for a broadcast.
     * @path /broadcasts/{broadcastId}/guests/{guestId}
     */
    match /broadcasts/{broadcastId}/guests/{guestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      // TODO: Add owner validation once the schema is updated with an ownership field.
    }

     /**
      * @description Allows users to 'like' a broadcast.
      * @path /broadcasts/{broadcastId}/likes/{userId}
      */
     match /broadcasts/{broadcastId}/likes/{userId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if false;
        allow delete: if false;
     }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}