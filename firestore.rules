rules_version = '2';

// LiveNet Firestore security rules.
//
// Principles:
//  - Public profile/stream data is readable by anyone.
//  - You can only write data that belongs to you, and only in the shape the app expects.
//  - Server-side code (the Stream webhook) uses the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function incoming() {
      return request.resource.data;
    }
    // Only these fields change in this update.
    function onlyChanges(fields) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId) && incoming().id == userId;
      allow update: if isUser(userId) && incoming().get('id', userId) == userId;
      allow delete: if isUser(userId);

      // Following: only I can change who I follow.
      match /following/{targetUserId} {
        allow read: if true;
        allow create: if isUser(userId) && targetUserId != userId && incoming().userId == userId;
        allow delete: if isUser(userId);
      }

      // Followers: I can add or remove *myself* from someone else's followers.
      match /followers/{followerUserId} {
        allow read: if true;
        allow create: if isUser(followerUserId) && followerUserId != userId
                      && incoming().userId == followerUserId;
        allow delete: if isUser(followerUserId) || isUser(userId);
      }

      // Owner-only content.
      match /highlights/{highlightId} {
        allow read: if true;
        allow write: if isUser(userId);
      }
      match /statuses/{statusId} {
        allow read: if true;
        allow write: if isUser(userId);
      }
      match /gifts/{giftId} {
        allow read: if true;
        allow write: if isUser(userId);
      }
      match /activities/{activityId} {
        allow read: if true;
        allow write: if isUser(userId);
      }
      match /challenges/{challengeId} {
        allow read: if true;
        allow write: if isUser(userId);
      }

      // Notifications: private to the owner. Others can create one *about
      // something they did* (like, comment, follow), signed with their own uid.
      match /notifications/{notificationId} {
        allow read, delete: if isUser(userId);
        allow update: if isUser(userId) && onlyChanges(['isRead']);
        allow create: if signedIn()
                      && request.auth.uid != userId
                      && incoming().actorId == request.auth.uid
                      && incoming().userId == userId
                      && incoming().type in ['like', 'comment', 'follow', 'gift', 'challenge']
                      && incoming().isRead == false
                      && (!('entityInfo' in incoming()) || shortString(incoming().entityInfo, 300));
      }
    }

    // ---------- broadcasts (live streams) ----------
    match /broadcasts/{broadcastId} {
      function isHost() {
        return isUser(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.hostId);
      }

      allow read: if true;
      allow create: if signedIn()
                    && incoming().hostId == request.auth.uid
                    && shortString(incoming().title, 120);
      // Only the host can change their stream, and they can't hand it to someone else.
      // (Streams that end unexpectedly are switched off by the Stream webhook on the server.)
      allow update: if isUser(resource.data.hostId)
                    && incoming().hostId == resource.data.hostId;
      allow delete: if isUser(resource.data.hostId);

      // Live chat: signed-in users post as themselves, max 500 characters.
      // Authors and the host (moderation) can delete.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if signedIn()
                      && incoming().userId == request.auth.uid
                      && shortString(incoming().message, 500);
        allow delete: if isUser(resource.data.userId) || isHost();
      }

      // One like per user; document id is the user's uid.
      match /likes/{userId} {
        allow read: if true;
        allow create, update: if isUser(userId) && incoming().userId == userId;
        allow delete: if isUser(userId);
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if signedIn();
      }

      // Guests: managed by the host; a guest may remove themselves.
      match /guests/{guestId} {
        allow read: if true;
        allow write: if isHost();
        allow delete: if isUser(guestId);
      }
    }

    // ---------- private chats ----------
    match /chats/{chatId} {
      function participants() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in incoming().participants;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in participants();
        allow create: if signedIn() && request.auth.uid in participants()
                      && incoming().senderId == request.auth.uid;
        allow update, delete: if signedIn() && request.auth.uid in participants()
                      && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
