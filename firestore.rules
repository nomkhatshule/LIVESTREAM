/**
 * @file Firestore Security Rules for AgoraLive
 * @version Prototyping
 * @corePhilosophy This ruleset enforces a user-ownership model for user profiles and a public-read, owner-write model for broadcasts.
 * Subcollections inherit the security context of their parent documents.
 * @dataStructure Data is organized into root collections for `users` and `broadcasts`.
 *  User-specific data is stored under `/users/{userId}`.
 *  Broadcast-related data is stored under `/broadcasts/{broadcastId}`, with subcollections for `messages`, `reactions`, `guests`, and `likes`.
 * @keySecurityDecisions Users can only read their own profile data, but broadcasts are publicly readable to facilitate discovery.
 *  Write access to broadcasts is restricted to the host user. Listing of user documents is denied to prevent enumeration.
 * @denormalizationForAuthorization Broadcast documents denormalize host information to simplify read operations and authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their profile document if userId == user_abc.
     * @allow (get, update, delete) - User with UID 'user_abc' can get, update, and delete their profile document if userId == user_abc.
     * @deny (create, update, delete) - User with UID 'user_xyz' cannot create, update, or delete the profile document for user 'user_abc'.
     * @deny (list) - Prevents listing all users.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (request.resource.data.id == resource.data.id);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to broadcast documents. Broadcasts are publicly readable but only editable by the host.
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) - Any user can read broadcast data.
     * @allow (create) - User with UID 'user_abc' can create a broadcast if request.resource.data.hostId == user_abc.
     * @allow (update, delete) - User with UID 'user_abc' can update or delete the broadcast if they are the host (resource.data.hostId == user_abc).
     * @deny (create, update, delete) - User with UID 'user_xyz' cannot create, update, or delete a broadcast owned by 'user_abc'.
     * @principle Allows public read access while enforcing document ownership for writes.
     */
    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.hostId);
      allow delete: if isExistingOwner(resource.data.hostId);
    }

    /**
     * @description Controls access to chat messages within a broadcast.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (get, list) - Any user can read chat messages for a broadcast.
     * @allow (create) - Any signed-in user can create a chat message.
     * @allow (update, delete) - No one can update or delete a chat message.
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Manages access to real-time reactions for a broadcast.
     * @path /broadcasts/{broadcastId}/reactions/{reactionId}
     * @allow (get, list) - Any user can read reactions for a broadcast.
     * @allow (create) - Any signed-in user can create a reaction.
     * @allow (update, delete) - No one can update or delete a reaction.
     */
    match /broadcasts/{broadcastId}/reactions/{reactionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Controls access to guest invitations and status within a broadcast.
     * @path /broadcasts/{broadcastId}/guests/{guestId}
     * @allow (get, list) - Any user can read guest information for a broadcast.
     * @allow (create) - Any signed-in user can create a guest entry.
     * @allow (update, delete) - No one can update or delete guest information.
     */
    match /broadcasts/{broadcastId}/guests/{guestId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

     /**
     * @description Manages access to likes for a broadcast.  Allows users to like the broadcasts, allows users to read the entire collection because  The useCollection hook needs this permission to get the like count.
     * @path /broadcasts/{broadcastId}/likes/{userId}
     * @allow (get, list) - Any user can read likes for a broadcast.
     * @allow (create) - Any signed-in user can create a like.
     * @allow (update, delete) - No one can update or delete a like.
     */
     match /broadcasts/{broadcastId}/likes/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(ownerId) {
    return isSignedIn() && request.auth.uid == ownerId && resource != null;
  }
}