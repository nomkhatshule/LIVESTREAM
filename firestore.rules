/**
 * @file Firestore Security Rules for AgoraLive
 * @description This ruleset enforces a user-ownership model for user profiles,
 * and a public-read, owner-write model for broadcasts. Subcollections for
 * broadcasts inherit the broadcast's write permissions.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information; only accessible by the
 *   user themselves.
 * - /broadcasts/{broadcastId}: Stores broadcast metadata; publicly readable,
 *   but only the host can modify.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Chat messages for a
 *   broadcast; anyone can create, but only the host can modify or delete.
 * - /broadcasts/{broadcastId}/reactions/{reactionId}: Reactions to a
 *   broadcast; anyone can create.
 * - /broadcasts/{broadcastId}/guests/{guestId}: Manages broadcast guests; only
 *   the host can modify.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Broadcast data is publicly readable to facilitate discovery.
 * - Broadcast creation, updates, and deletion are restricted to the host.
 * - Reactions are ephemeral and created by viewers.
 *
 * Denormalization for Authorization:
 * - Broadcast documents denormalize host information (hostId, hostName,
 *   hostAvatar) to simplify read operations and security rules.
 *
 * Structural Segregation:
 * - User profiles and broadcast data are stored in separate collections to
 *   clearly separate ownership models.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their own profile document at /users/user_abc if request.auth.uid == 'user_abc'
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their own profile document at /users/user_abc.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile document for user 'user_abc' at /users/user_abc because request.auth.uid != 'user_abc'
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot read, update, or delete the profile document of user 'user_abc' at /users/user_abc.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows anyone to read broadcasts, but only the host can modify them.
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) - Any user (or unauthenticated user) can read broadcast data.
     * @allow (create) - User with UID 'user_abc' can create a broadcast if request.resource.data.hostId == 'user_abc'
     * @allow (update, delete) - User with UID 'user_abc' can update/delete broadcast with hostId = 'user_abc'
     * @deny (create) - User with UID 'user_xyz' cannot create a broadcast with hostId = 'user_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot update/delete a broadcast where resource.data.hostId != 'user_xyz'.
     * @principle Allows public reads but restricts writes to the owner.
     */
    match /broadcasts/{broadcastId} {
      function isOwner(hostId) {
        return request.auth != null && request.auth.uid == hostId;
      }

      allow get, list: if true;
      allow create: if isOwner(request.resource.data.hostId) && request.resource.data.hostId == request.auth.uid;
      allow update: if isOwner(resource.data.hostId) && resource != null;
      allow delete: if isOwner(resource.data.hostId) && resource != null;

      /**
       * @description Allows anyone to create chat messages, but only the host can modify them.
       * @path /broadcasts/{broadcastId}/messages/{messageId}
       * @allow (get, list) - Any user (or unauthenticated user) can read broadcast messages.
       * @allow (create) - Any logged in user can create a message.
       * @allow (update, delete) - Only the host can update or delete messages.
       * @principle  Allows anyone to create messages, but restricts edits to the owner.
       */
      match /messages/{messageId} {
        allow get, list: if true;
        allow create: if request.auth != null;
        allow update: if isOwner(resource.data.userId) && resource != null;
        allow delete: if isOwner(resource.data.userId) && resource != null;
      }

      /**
       * @description Allows anyone to create reactions.
       * @path /broadcasts/{broadcastId}/reactions/{reactionId}
       * @allow (get, list) - Any user (or unauthenticated user) can read broadcast reactions.
       * @allow (create) - Any logged in user can create a reaction.
       * @deny (update, delete) - Reactions cannot be updated or deleted.
       * @principle  Allows anyone to create ephemeral reactions.
       */
      match /reactions/{reactionId} {
        allow get, list: if true;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      /**
       * @description Allows only the host to manage guests.
       * @path /broadcasts/{broadcastId}/guests/{guestId}
       * @allow (get, list) - Any user (or unauthenticated user) can read broadcast guests.
       * @allow (create, update, delete) - Only the host can create/update/delete guests.
       * @principle Restricts guest management to the broadcast host.
       */
      match /guests/{guestId} {
        allow get, list: if true;
        allow create: if isOwner(resource.data.userId);
        allow update: if isOwner(resource.data.userId) && resource != null;
        allow delete: if isOwner(resource.data.userId) && resource != null;
      }
    }
  }
}