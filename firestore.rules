/**
 * @fileoverview Firestore Security Rules for AgoraLive.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access with owner-only writes for broadcasts.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, secured with path-based ownership.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Stores chat messages associated with a broadcast,
 *   without specific write restrictions beyond Firebase authentication.
 *
 * Key Security Decisions:
 * - User listing is not explicitly denied, defaulting to Firebase's implicit denial.
 * - Broadcasts are publicly readable, but only the owner can modify them. The current rules do not fully define the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User 'pDOa2Wd87RV6kCz0fbBdN095PIh1' can create their profile if userId matches their auth UID.
     * @deny (create) User 'attackerId' cannot create a profile with userId 'victimId'.
     * @allow (get, list) User 'pDOa2Wd87RV6kCz0fbBdN095PIh1' can read their profile.
     * @deny (get, list) User 'attackerId' cannot read the profile of user 'victimId'.
     * @allow (update, delete) User 'pDOa2Wd87RV6kCz0fbBdN095PIh1' can update/delete their profile.
     * @deny (update, delete) User 'attackerId' cannot update/delete the profile of user 'victimId'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to chat messages within a broadcast.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (create) Any authenticated user can create a chat message.
     * @deny (create) Unauthenticated users cannot create chat messages.
     * @allow (get, list) Any user can read chat messages.
     * @allow (update, delete) Any authenticated user can update/delete any message.
     * @deny (update, delete) Unauthenticated users cannot update/delete messages.
     * @principle Authenticated users can send and read messages in a broadcast.
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    /**
     * @description Controls access to broadcasts.
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) Any user can read broadcasts.
     *
     * @principle Public read access with owner-only writes.
     */
    match /broadcasts/{broadcastId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}