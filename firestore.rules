/**
 * @fileoverview Firestore Security Rules for AgoraLive platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and allows broadcasters to create live broadcasts. Chat messages within
 * broadcasts are secured based on the broadcast's existence.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Stores chat messages for a specific broadcast.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Broadcast creation is allowed with host ownership validation.
 *
 * Denormalization for Authorization:
 * - Broadcast documents should include a `hostId` field that matches the creator's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Helper function to check if the user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (get, update, delete): User pDOa2Wd87RV6kCz0fbBdN095PIh1 can read/write their own profile.
     * @allow (create): User pDOa2Wd87RV6kCz0fbBdN095PIh1 can create their own profile.
     * @allow (list): User pDOa2Wd87RV6kCz0fbBdN095PIh1 can list their own profile, although this operation is unusual.
     * @deny (get, update, delete): User anotherUser cannot read/write user pDOa2Wd87RV6kCz0fbBdN095PIh1 profile.
     * @deny (create): User anotherUser cannot create user pDOa2Wd87RV6kCz0fbBdN095PIh1 profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for broadcasts.
     * @path /broadcasts/{broadcastId}
     * @allow (create): User pDOa2Wd87RV6kCz0fbBdN095PIh1 can create a broadcast if they are the host.
     * @allow (get, list): Any user can view the broadcasts.
     * @deny (update, delete): Only the host can update or delete a broadcast.
     * @principle Enforces owner-only writes for broadcasts, allowing public read access.
     */
    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rules for chat messages within a broadcast.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (create): Any signed-in user can create a chat message in a broadcast.
     * @allow (get, list): Any user can read chat messages within a broadcast.
     * @deny (update, delete): No one can update or delete existing chat messages.
     * @principle Allows public read access and signed-in users can create messages.
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}