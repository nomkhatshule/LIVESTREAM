/**
 * @file Firestore Security Rules for AgoraLive
 * @core_philosophy This ruleset enforces a user-ownership model for user profiles and allows public read access to broadcasts while restricting write access to the host.
 * Subcollections like messages, reactions, likes, and guests are secured to be writeable only by authenticated users.
 * @data_structure
 * - `/users/{userId}`: Stores user profile information, accessible only to the user themselves.
 * - `/broadcasts/{broadcastId}`: Stores broadcast metadata, publicly readable, but only the host can modify it.
 * - `/broadcasts/{broadcastId}/messages/{messageId}`: Chat messages within a broadcast, writeable by any authenticated user.
 * - `/broadcasts/{broadcastId}/reactions/{reactionId}`: Real-time reactions, writeable by any authenticated user.
 * - `/broadcasts/{broadcastId}/guests/{guestId}`: Guest management, writeable only by authenticated users.
 * - `/broadcasts/{broadcastId}/likes/{userId}`: Broadcast likes, writeable only by authenticated users.
 * @key_security_decisions
 * - Users can only read and write their own profile data.
 * - Broadcasts are publicly readable but only the host can modify them.
 * - Listing of users is disallowed.
 * - All write operations require authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the owner can read and write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) User with UID 'user123' can read/write /users/user123.
     * @allow (create) User with UID 'user123' can create /users/user123.
     * @deny (get, update, delete) User with UID 'user456' cannot read/write /users/user123.
     * @deny (create) User with UID 'user456' cannot create /users/user123.
     * @principle Enforces strict user-ownership for profile data.
     */
    match /users/{userId} {
      // Test
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure broadcasts. Broadcasts are publicly readable, but only the host can modify them.
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) Any user can read any broadcast.
     * @allow (create, update, delete) User with UID 'user123' can create/update/delete /broadcasts/broadcast1 if they are the host.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete /broadcasts/broadcast1, if they are not the host.
     * @principle Allows public read access but restricts write access to the host.
     */
    match /broadcasts/{broadcastId} {
      function isHost(hostId) {
        return request.auth.uid == hostId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.hostId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.hostId;

      /**
       * @description Secure chat messages within a broadcast. Any authenticated user can create messages.
       * @path /broadcasts/{broadcastId}/messages/{messageId}
       * @allow (create) Any authenticated user can create a message in any broadcast.
       * @allow (get, list) Any user can read any message in any broadcast.
       * @deny (update, delete) No user can update or delete any message in any broadcast.
       * @principle Allows any authenticated user to send messages in a broadcast.
       */
      match /messages/{messageId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      /**
       * @description Secure real-time reactions within a broadcast. Any authenticated user can create reactions.
       * @path /broadcasts/{broadcastId}/reactions/{reactionId}
       * @allow (create) Any authenticated user can create a reaction in any broadcast.
       * @allow (get, list) Any user can read any reaction in any broadcast.
       * @deny (update, delete) No user can update or delete any reaction in any broadcast.
       * @principle Allows any authenticated user to send reactions in a broadcast.
       */
      match /reactions/{reactionId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      /**
       * @description Secure guest management within a broadcast. Any authenticated user can create/manage guests.
       * @path /broadcasts/{broadcastId}/guests/{guestId}
       * @allow (create) Any authenticated user can create a guest entry in any broadcast.
       * @allow (get, list) Any user can read any guest entry in any broadcast.
       * @deny (update, delete) No user can update or delete any guest entry in any broadcast.
       * @principle Allows guest management for a broadcast.
       */
      match /guests/{guestId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

       /**
         * @description Secure likes for a broadcast. Any authenticated user can like a broadcast. The document ID must match the user's UID.
         * @path /broadcasts/{broadcastId}/likes/{userId}
         * @allow (create) User with UID 'user123' can like /broadcasts/broadcast1 by creating /broadcasts/broadcast1/likes/user123.
         * @allow (get) Any user can check if a user liked a broadcast.
         * @deny (update, delete) Likes cannot be updated or deleted.
         * @principle Allows any authenticated user to like a broadcast once.
         */
      match /likes/{userId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
  }
}