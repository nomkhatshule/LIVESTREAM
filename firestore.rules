rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Users Collection ---
    // Users can read any public profile.
    // Users can only create and update their OWN profile document.
    match /users/{userId} {
      allow read;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      // Users can only read their own 'following' and 'followers' lists.
      match /following/{targetUserId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /followers/{followerUserId} {
         allow read: if request.auth != null;
         allow create, delete: if request.auth != null && (request.auth.uid == followerUserId || request.auth.uid == userId);
      }
      
      // Users can read and update their own highlights
      match /highlights/{highlightId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Users can read and update their own notifications
      match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null; // Allow other users to create notifications for this user
      }
    }

    // --- Broadcasts Collection ---
    // Anyone can read broadcasts.
    // Logged-in users can create broadcasts.
    // Only the host can update or delete their own broadcast.
    match /broadcasts/{broadcastId} {
      allow read;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.hostId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;

      // --- Sub-collections ---
      // Logged-in users can read/write to chat, likes, and reactions.
      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
      match /likes/{userId} {
        allow read, create: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /reactions/{reactionId} {
         allow read, create: if request.auth != null;
      }
    }
  }
}
