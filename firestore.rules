
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;

      // Following/Followers can be read by anyone, but only the owner can modify their own lists.
      match /following/{targetUserId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }
      match /followers/{followerUserId} {
        allow read: if true;
        // Allow users to add/remove themselves from other users' followers list.
        allow write: if request.auth.uid == followerUserId;
      }

      // Statuses can be read by anyone, but only the user who owns them can write.
      match /statuses/{statusId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }

      // Highlights can be read by anyone, but only the user who owns them can write.
      match /highlights/{highlightId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }

      // Gifts can be read by anyone, but only the user who owns them can write.
      match /gifts/{giftId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }

      // Activities can be read by anyone, but only the user who owns them can write.
      match /activities/{activityId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }

      // Notifications can be read/updated/deleted by the owner. Any authenticated user can create them.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth.uid == userId;
        allow create: if request.auth != null;
      }
      
      // Challenges can be read/listed by the recipient, and created by any authenticated user.
      match /challenges/{challengeId} {
        allow list, read, update, delete: if request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Allow anyone to query the list of broadcasts
    match /broadcasts {
      allow list: if true;
    }

    // Broadcasts can be read by anyone. Only the host can create, update or end their own stream.
    match /broadcasts/{broadcastId} {
      allow get, read: if true;
      allow create: if request.auth.uid == request.resource.data.hostId;
      // Host can update anything.
      // Any authenticated user can update a document IF the only field changing is `isLive` from true to false.
      // This allows the client-side "End Stream" button to work, but prevents a client from maliciously re-activating a stream.
      // The server-side webhook is the ultimate authority for ending a stream.
      allow update: if request.auth.uid == resource.data.hostId ||
                    (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLive']) && resource.data.isLive == true && request.resource.data.isLive == false);
      allow delete: if request.auth.uid == resource.data.hostId;


      // Messages can be read by anyone. Authenticated users can create messages.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
      }

      // Likes can be read by anyone. Authenticated users can create/delete their own like.
      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }

      // Reactions can be written by any authenticated user.
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
      
      // Guest status can be read by anyone, but only the host can update it.
      match /guests/{guestId} {
        allow read: if true;
        allow write: if request.auth.uid == resource.data.hostId || request.auth.uid == guestId;
      }
    }
    
    // Chats can be read and written by the participants of the chat.
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
