/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access to broadcasts.
 * Data is organized into root collections for users and broadcasts, with subcollections for chat messages, reactions, likes, guests, following, and followers.
 *
 * Core Philosophy:
 * - User data is private and only accessible to the owning user.
 * - Broadcast data is publicly readable but only modifiable by the host.
 * - Subcollections inherit the access control of their parent documents, with additional constraints.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with userId matching the Firebase Auth UID.
 * - /broadcasts/{broadcastId}: Stores broadcast metadata.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Stores chat messages for a broadcast.
 * - /broadcasts/{broadcastId}/reactions/{reactionId}: Stores reactions for a broadcast.
 * - /broadcasts/{broadcastId}/guests/{guestId}: Stores guest information for a broadcast.
 * - /broadcasts/{broadcastId}/likes/{userId}: Stores likes for a broadcast.
 * - /users/{userId}/following/{targetUserId}: Stores user follow relationships.
 * - /users/{userId}/followers/{followerUserId}: Stores user follower relationships.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Broadcasts are publicly readable to maximize discoverability.
 * - Only the host of a broadcast can modify it.
 * - Listing of user documents is disallowed to protect user privacy.
 * - Data validation is relaxed in this prototyping phase to allow for rapid iteration.
 *
 * Denormalization for Authorization:
 * - Broadcast documents denormalize host information (hostName, hostAvatar) for efficient read access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile (userId matches auth.uid).
     * @deny (get, create, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the existing owner of the document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Disabling listing of all users for privacy

      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

        /**
       * @description Allow anyone to read public user profiles,
       * Users can update their own profile. Nested rules for the 'followers' sub-collection.
       * @path /users/{userId}/followers/{followerId}
       * @allow (list, get) if the user is signed in.
       * @allow (create, delete) if the user is adding/removing THEMSELVES as a follower.
       * @deny (update) to everyone.
       * @principle Allow users to manage their OWN list of who they are following.
       */
      match /followers/{followerId} {
        // Anyone signed in can see the list of followers (for counting)
        allow list, get: if request.auth != null;

        // A user can only add/remove THEMSELVES as a follower
        allow create, delete: if request.auth.uid == followerId;

        // No one can update a follow record
        allow update: if false;
      }

      /**
       * @description Allow anyone to read public user profiles,
       * Users can update their own profile. Nested rules for the 'following' sub-collection.
       * @path /users/{userId}/following/{targetUserId}
       * @allow (list, get) if the user is signed in.
       * @allow (create, delete) if the user is managing their OWN list of who they are following.
       * @deny (update) to everyone.
       * @principle Allow users to manage their OWN list of who they are following.
       */
      match /following/{targetUserId} {
        // Anyone signed in can see who a user is following
        allow list, get: if request.auth != null;

        // A user can only manage their OWN list of who they are following
        allow create, delete: if request.auth.uid == userId;

        // No one can update a following record
        allow update: if false;
      }
    }

    /**
     * @description Controls access to broadcast metadata.
     * @path /broadcasts/{broadcastId}
     * @allow (get, list) to anyone.
     * @allow (create) if the user is authenticated. The hostId field must match the auth.uid.
     * @allow (update, delete) if the user is the host of the broadcast.
     * @deny (create, update, delete) if the user is not the host of the broadcast.
     * @principle Allows public read access with owner-only writes, enforcing host control.
     */
    match /broadcasts/{broadcastId} {
      // Helper function to check if the authenticated user is the host of the broadcast.
      function isHost(hostId) {
        return request.auth.uid == hostId;
      }

       // Helper function to check if the authenticated user is the existing host of the broadcast.
      function isExistingHost(hostId) {
        return isHost(hostId) && resource != null;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;

      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && isHost(resource.data.hostId);
      allow delete: if isSignedIn() && isHost(resource.data.hostId);

         /**
         * @description Rules for the 'likes' sub-collection.
         * Allow a user to create/delete their own like, BUT ONLY if the broadcast is live.
         * @path /broadcasts/{broadcastId}/likes/{userId}
         * @allow (list, get) to any signed-in user to read the list of likes for counting.
         * @allow (create, delete) if the user is the owner and if the broadcast is live.
         * @deny (update) to everyone.
         * @principle Allow users to manage their OWN list of who they are following.
        */
        match /likes/{userId} {
          // Allow any signed-in user to read the list of likes for counting.
          allow list, get: if request.auth != null;

          // Allow a user to create/delete their own like, BUT ONLY if the broadcast is live.
          // get() is a function that lets us read another document in our rules.
          // We read the parent broadcast document to check its 'isLive' status.
          allow create: if request.auth.uid == userId && get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.isLive == true;
          allow delete: if request.auth.uid == userId && get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.isLive == true;


          // Nobody can ever update a like document.
          allow update: if false;
        }

        match /messages/{messageId} {
            allow read, write: if request.auth != null;
        }

        match /reactions/{reactionId} {
            allow read, write: if request.auth != null;
        }

        match /guests/{guestId} {
            allow read, write: if false;
        }
    }

    /**
     * @description Controls access to chat messages within a broadcast.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (get, list, create) if the user is authenticated.
     * @deny (update, delete) to everyone.
     * @principle Allows anyone to read and send messages in a broadcast chat.
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to reactions within a broadcast.
     * @path /broadcasts/{broadcastId}/reactions/{reactionId}
     * @allow (get, list, create) if the user is authenticated.
     * @deny (update, delete) to everyone. Reactions are ephemeral.
     * @principle Allows anyone to send real-time reactions to a broadcast.
     */
    match /broadcasts/{broadcastId}/reactions/{reactionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to guest information within a broadcast.
     * @path /broadcasts/{broadcastId}/guests/{guestId}
     * @allow (get, list) if the user is authenticated.
     * @allow (create, update, delete) if the user is the host of the broadcast.
     * @deny (create, update, delete) if the user is not the host of the broadcast.
     * @principle Restricts guest management to the broadcast host.
     */
    match /broadcasts/{broadcastId}/guests/{guestId} {
      // Helper function to check if the authenticated user is the host of the broadcast.
      function isHost(hostId) {
        return request.auth.uid == hostId;
      }

       // Helper function to check if the authenticated user is the existing host of the broadcast.
      function isExistingHost(hostId) {
        return isHost(hostId) && resource != null;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && isHost(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.hostId);
      allow update: if isSignedIn() && isHost(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.hostId);
      allow delete: if isSignedIn() && isHost(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.hostId);
    }

     /**
     * @description Controls access to likes within a broadcast.
     * @path /broadcasts/{broadcastId}/likes/{userId}
     * @allow (get, list) if the user is authenticated.
     * @allow (create) if the user is authenticated and the userId matches the auth.uid.
     * @deny (update, delete) to everyone. Likes are created and not updated/deleted.
     * @principle Allows users to like a broadcast, restricting likes to authenticated users.
     */
    match /broadcasts/{broadcastId}/likes/{userId} {
       function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to following relationships for a user.
     * @path /users/{userId}/following/{targetUserId}
     * @allow (get, list, create) if the user is the owner (userId matches auth.uid).
     * @deny (update, delete) to everyone. Follow relationships are created and not updated/deleted.
     * @principle Allows users to manage their own following list.
     */
    match /users/{userId}/following/{targetUserId} {
       function isOwner(userId) {
        return request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to follower relationships for a user.
     * @path /users/{userId}/followers/{followerUserId}
     * @allow (get, list) if the user is the owner (userId matches auth.uid).
     * @deny (create, update, delete) to everyone. Follower relationships are managed by the target user.
     * @principle Allows users to view their own follower list.
     */
    match /users/{userId}/followers/{followerUserId} {
       function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}