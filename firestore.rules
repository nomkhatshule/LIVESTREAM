rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can be read by anyone, but only the authenticated user can update their own profile.
    match /users/{userId} {
      allow read: if true;
      allow update: if request.auth.uid == userId;

      // Highlights can be read by anyone, but only the owner can create/delete them.
      match /highlights/{highlightId} {
        allow read: if true;
        allow create, delete: if request.auth.uid == userId;
      }

      // Following/Followers can be read by anyone, but only the owner can modify their own lists.
      match /following/{targetUserId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }
      match /followers/{followerUserId} {
        allow read: if true;
        // Followers list is managed by the actions of other users, so owner of this doc should not have write access.
        // Writes are handled by the 'following' rule on the other user's doc.
        allow write: if false; 
      }
    }

    // Broadcasts can be read by anyone. Only the host can create, update or end their own stream.
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.hostId;
      allow update: if request.auth.uid == resource.data.hostId;

      // Messages can be read by anyone. Authenticated users can create messages.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
      }

      // Likes can be read by anyone. Authenticated users can create/delete their own like.
      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }

      // Reactions can be written by any authenticated user.
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
      
      // Guest status can be read by anyone, but only the host can update it.
      match /guests/{guestId} {
        allow read: if true;
        allow write: if request.auth.uid == get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.hostId;
      }
    }
  }
}
