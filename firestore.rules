/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access to broadcast metadata.
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. The userId is equal to the Firebase Authentication UID.
 * - /broadcasts/{broadcastId}: Core document for a live stream. Contains metadata about the session.
 * - /broadcasts/{broadcastId}/messages/{messageId}: Sub-collection storing chat messages for a specific broadcast.
 * - /broadcasts/{broadcastId}/reactions/{reactionId}: Sub-collection for ephemeral real-time reactions. Documents should have a TTL policy.
 * - /broadcasts/{broadcastId}/guests/{guestId}: Sub-collection managing the state of guests (co-hosts) for a broadcast.
 * - /broadcasts/{broadcastId}/likes/{userId}: Sub-collection storing likes for a broadcast. The document ID is the UID of the user who liked it.
 * - /users/{userId}/following/{targetUserId}: Sub-collection where each document represents a user that {userId} is following. The document ID is the UID of the user being followed.
 * - /users/{userId}/followers/{followerUserId}: Sub-collection where each document represents a user that is following {userId}. The document ID is the UID of the follower.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owning user.
 * - Broadcast metadata is publicly readable, but only the host can modify it.
 * - User listing is disallowed to protect user privacy.
 * - Default security posture for ambiguous relationships is strict: deny access unless explicitly allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @allow (get) User with UID 'user123' can read their own profile.
     * @deny (get) User with UID 'user456' cannot read the profile of 'user123'.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @deny (update) User with UID 'user456' cannot update the profile of 'user123'.
     * @allow (delete) User with UID 'user123' can delete their own profile.
     * @deny (delete) User with UID 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to broadcast metadata.
     * @path /broadcasts/{broadcastId}
     * @allow (get) Any user can read broadcast metadata.
     * @allow (list) Any user can list broadcasts.
     * @allow (create) Not allowed.
     * @deny (update) Any user cannot update any broadcast.
     * @deny (delete) Any user cannot delete any broadcast.
     * @principle Public read, owner-only writes (not yet implemented due to missing ownerId field).
     */
    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to chat messages within a broadcast.
     * @path /broadcasts/{broadcastId}/messages/{messageId}
     * @allow (get) Any user can read chat messages in a broadcast.
     * @allow (list) Any user can list chat messages in a broadcast.
     * @allow (create) Any signed-in user can create a chat message.
     * @deny (update) No user can update a chat message.
     * @deny (delete) No user can delete a chat message.
     * @principle Public read, authenticated create.
     */
    match /broadcasts/{broadcastId}/messages/{messageId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Controls access to reactions within a broadcast.
     * @path /broadcasts/{broadcastId}/reactions/{reactionId}
     * @allow (get) Any user can read reactions in a broadcast.
     * @allow (list) Any user can list reactions in a broadcast.
     * @allow (create) Any signed-in user can create a reaction.
     * @deny (update) No user can update a reaction.
     * @deny (delete) No user can delete a reaction.
     * @principle Public read, authenticated create.
     */
    match /broadcasts/{broadcastId}/reactions/{reactionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Controls access to guest management within a broadcast.
     * @path /broadcasts/{broadcastId}/guests/{guestId}
     * @allow (get) Any user can read the guest list.
     * @allow (list) Any user can list guests in a broadcast.
     * @deny (create) No user can create a guest without proper authorization (e.g., host).
     * @deny (update) No user can update a guest's status without proper authorization (e.g., host).
     * @deny (delete) No user can delete a guest without proper authorization (e.g., host).
     * @principle Requires host authorization (not yet implemented).
     */
    match /broadcasts/{broadcastId}/guests/{guestId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Implement host-based authorization.
    }

      /**
       * @description Controls access to likes within a broadcast.
       * @path /broadcasts/{broadcastId}/likes/{userId}
       * @allow (get) Any user can read the like.
       * @allow (list) Any user can list likes in a broadcast.
       * @allow (create) Any signed-in user can create a like.
       * @deny (update) No user can update a like.
       * @allow (delete) The user who created the like can delete it.
       * @principle Requires host authorization (not yet implemented).
       */
      match /broadcasts/{broadcastId}/likes/{userId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId && resource != null;
      }


    /**
     * @description Controls access to following relationships.
     * @path /users/{userId}/following/{targetUserId}
     * @allow (get) The owner can read their following list.
     * @allow (list) The owner can list their following.
     * @allow (create) The owner can create follow relationships.
     * @deny (update) No user can update follow relationships.
     * @allow (delete) The owner can delete follow relationships.
     * @principle Enforces ownership.
     */
    match /users/{userId}/following/{targetUserId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to follower relationships.
     * @path /users/{userId}/followers/{followerUserId}
     * @allow (get) The owner can read their followers.
     * @allow (list) The owner can list their followers.
     * @deny (create) Only the system manages follower relationships.
     * @deny (update) No user can update follow relationships.
     * @deny (delete) Only the system manages follower relationships.
     * @principle System-managed relationships.
     */
    match /users/{userId}/followers/{followerUserId} {
      allow get, list: if isOwner(userId);
      allow create, update, delete: if false;
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}