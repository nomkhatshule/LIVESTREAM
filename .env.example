# Copy this file to .env.local for local development and fill in the values.
# NEVER commit real keys. In production these come from apphosting.yaml
# (secrets are stored in Google Secret Manager, not in the code).

# --- Public: shipped to the browser. Fine to expose, but restrict by domain
#     in each provider's dashboard where possible. ---
NEXT_PUBLIC_STREAM_API_KEY=
NEXT_PUBLIC_ALGOLIA_APP_ID=
# Use Algolia's *search-only* key here, never the admin key.
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_GIPHY_API_KEY=
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# --- Secret: server only. Never prefix with NEXT_PUBLIC_. ---
STREAM_API_SECRET=
